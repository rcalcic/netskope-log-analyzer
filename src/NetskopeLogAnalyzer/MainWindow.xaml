<Window x:Class="NetskopeLogAnalyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Netskope Log Analyzer" Width="1360" Height="900" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" AllowDrop="True" Background="{DynamicResource Background}"
        FontFamily="Segoe UI" FontSize="14" Foreground="{DynamicResource Ink}"
        Icon="icon.png" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        DragEnter="Window_DragEnter" DragOver="Window_DragEnter" DragLeave="Window_DragLeave" Drop="Window_Drop">
  <DockPanel>
    <!-- barra superior -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource Night}" Padding="20,10">
      <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <Button x:Name="BtnCopyReport" Content="Copiar relatório" Style="{StaticResource PillOnNight}" Margin="8,0,0,0" Visibility="Collapsed" Click="CopyReport_Click"/>
          <Button x:Name="BtnSaveReport" Content="Salvar relatório…" Style="{StaticResource PillOnNight}" Margin="8,0,0,0" Visibility="Collapsed" Click="SaveReport_Click"/>
          <Button x:Name="BtnTheme" Content="☾" ToolTip="Alternar tema claro/escuro" Style="{StaticResource PillOnNight}" FontFamily="Segoe UI Symbol" Margin="8,0,0,0" Padding="14,0" Click="Theme_Click" AutomationProperties.Name="Alternar tema"/>
          <Button x:Name="BtnSettings" Content="Configurações" Style="{StaticResource PillOnNight}" Margin="8,0,0,0" Click="Settings_Click"/>
          <Button x:Name="BtnOpen" Content="Abrir pacote…" Style="{StaticResource PillOnNight}" Margin="8,0,0,0" Click="Open_Click"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="icon.png" Width="30" Height="30" Margin="0,0,12,0"/>
          <TextBlock Text="Netskope Log Analyzer" Foreground="White" FontSize="19" FontWeight="Bold" VerticalAlignment="Center"/>
          <TextBlock x:Name="TxtVersion" Foreground="{DynamicResource NightMute}" Margin="10,2,0,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="TxtFileName" Foreground="{DynamicResource NightMute}" Margin="18,2,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- barra de atualização -->
    <Border x:Name="UpdateBar" DockPanel.Dock="Top" Background="{DynamicResource BlueBg}" BorderBrush="{DynamicResource Blue}" BorderThickness="0,0,0,2" Padding="20,8" Visibility="Collapsed">
      <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <Button x:Name="BtnUpdateNow" Content="Atualizar agora" Style="{StaticResource PillDark}" MinHeight="32" Click="UpdateNow_Click"/>
          <Button Content="Novidades" Style="{StaticResource Small}" Margin="8,0,0,0" Click="UpdateNotes_Click"/>
          <Button Content="Ignorar esta versão" Style="{StaticResource Small}" Margin="8,0,0,0" Click="UpdateSkip_Click"/>
        </StackPanel>
        <TextBlock x:Name="UpdateText" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" TextWrapping="Wrap"/>
      </DockPanel>
    </Border>

    <Grid>
      <!-- ======================= tela inicial ======================= -->
      <ScrollViewer Foreground="{DynamicResource Ink}" x:Name="DropView" VerticalScrollBarVisibility="Auto">
        <Grid Margin="56,40" MaxWidth="1240">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="40"/>
            <ColumnDefinition Width="1.15*"/>
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Top">
            <TextBlock Text="Analise o pacote de logs do usuário." FontSize="34" FontWeight="Bold" TextWrapping="Wrap" LineHeight="40"/>
            <TextBlock Margin="0,12,0,0" FontSize="15" TextWrapping="Wrap" Foreground="{DynamicResource Mute}">
              Importe o <Bold>.zip</Bold> salvo pelo Netskope Client (“Save logs” / nsdiag -o). O app separa o que é problema real do que é ruído conhecido e mostra como resolver cada item.
            </TextBlock>

            <TextBlock Text="1. O que o usuário relatou? (opcional, pode marcar vários)" TextWrapping="Wrap" FontWeight="Bold" FontSize="16" Margin="0,24,0,8"/>
            <WrapPanel x:Name="SymptomChips"/>
            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1*"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Site ou aplicação afetada" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4"/>
                <TextBox x:Name="InDomain" Padding="8,6" ToolTip="Ex.: teams.microsoft.com ou https://intranet.empresa.com/pagina" MaxLength="300"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Horário aproximado do problema" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4"/>
                <TextBox x:Name="InTime" Padding="8,6" ToolTip="Ex.: 23/11 12:44 ou 23/11/2026 12:44 (horário da máquina do usuário)" MaxLength="40"/>
              </StackPanel>
            </Grid>
            <TextBlock x:Name="TxtFocusHint" Foreground="{DynamicResource Mute}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="Com o relato, o app direciona a análise: roda as verificações de cada sintoma, mostra as evidências e destaca o que aconteceu perto do horário informado."/>

            <TextBlock Text="2. Abra o pacote" FontWeight="Bold" FontSize="16" Margin="0,22,0,6"/>
            <TextBlock Foreground="{DynamicResource Mute}" TextWrapping="Wrap">
              🔒 A análise roda inteiramente neste computador. Nenhum log é enviado para lugar nenhum — o pacote contém dados sensíveis (token, serial, e-mails).
            </TextBlock>
            <Border Margin="0,16,0,0" Padding="16" CornerRadius="14" Background="{DynamicResource Soft}">
              <StackPanel>
                <TextBlock Text="Como pedir os logs ao usuário" FontWeight="Bold" FontSize="15"/>
                <TextBlock Foreground="{DynamicResource Mute}" Margin="0,4,0,8" TextWrapping="Wrap">
                  Peça para salvar o pacote logo depois do problema (os logs giram por tamanho) e informar o horário aproximado em que aconteceu.
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"><Run FontWeight="SemiBold" Text="Windows / macOS: "/><Run Text="ícone do Netskope na bandeja (barra de menus no Mac) › Save logs. O .zip vai para a Área de Trabalho."/></TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"><Run FontWeight="SemiBold" Text="Linux: "/><Run FontFamily="Consolas" Text="/opt/netskope/stagent/nsdiag -o ~/NetskopeLogs.zip"/></TextBlock>
                <TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="Windows (linha de comando): "/><Run FontFamily="Consolas" Text="&quot;C:\Program Files (x86)\Netskope\STAgent\nsdiag.exe&quot; -o %USERPROFILE%\Desktop\NetskopeLogs.zip"/></TextBlock>
              </StackPanel>
            </Border>
          </StackPanel>

          <Grid Grid.Column="2" MinHeight="380">
            <Rectangle x:Name="DropRect" RadiusX="24" RadiusY="24" Stroke="{DynamicResource Ink}" StrokeThickness="3" StrokeDashArray="4 3" Fill="{DynamicResource Soft}"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
              <Image Source="icon.png" Width="120" Height="120" Margin="0,0,0,18"/>
              <TextBlock Text="Arraste o .zip aqui" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
              <TextBlock Text="ou" Foreground="{DynamicResource Mute}" HorizontalAlignment="Center" Margin="0,6"/>
              <Button Content="Escolher arquivos…" Style="{StaticResource PillDark}" HorizontalAlignment="Center" Click="Open_Click"/>
              <ProgressBar x:Name="Busy" IsIndeterminate="True" Height="6" Width="260" Margin="0,20,0,0" Visibility="Collapsed"/>
              <TextBlock x:Name="TxtProgress" Margin="0,10,0,0" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420"/>
            </StackPanel>
          </Grid>
        </Grid>
      </ScrollViewer>

      <!-- ======================= resultados ======================= -->
      <TabControl x:Name="Tabs" Visibility="Collapsed" Background="{DynamicResource Background}" Foreground="{DynamicResource Ink}" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Line}" Padding="0" Margin="16,8,16,0">
        <TabItem x:Name="TabSummary" Header="Resumo">
          <ScrollViewer Foreground="{DynamicResource Ink}" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="SummaryPanel" Margin="8,16,8,24"/>
          </ScrollViewer>
        </TabItem>

        <TabItem x:Name="TabIncidents" Header="Incidentes">
          <ScrollViewer Foreground="{DynamicResource Ink}" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="IncidentsPanel" Margin="8,16,8,24"/>
          </ScrollViewer>
        </TabItem>

        <TabItem x:Name="TabExperience" Header="Experiência">
          <ScrollViewer Foreground="{DynamicResource Ink}" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ExperiencePanel" Margin="8,16,8,24"/>
          </ScrollViewer>
        </TabItem>

        <TabItem x:Name="TabPerformance" Header="Desempenho">
          <ScrollViewer Foreground="{DynamicResource Ink}" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PerformancePanel" Margin="8,16,8,24"/>
          </ScrollViewer>
        </TabItem>

        <TabItem x:Name="TabTimeline" Header="Linha do tempo">
          <ScrollViewer Foreground="{DynamicResource Ink}" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="8,16,8,24">
              <TextBlock Text="Linha do tempo do cliente" FontSize="24" FontWeight="Bold"/>
              <TextBlock Foreground="{DynamicResource Mute}" Margin="0,6,0,12" TextWrapping="Wrap"
                         Text="Cada estação é um evento: início/parada do serviço, registro, túnel conectado ou derrubado, mudança de localização. Passe o mouse para ver detalhes."/>
              <Border Background="{DynamicResource Soft}" CornerRadius="16">
                <ScrollViewer Foreground="{DynamicResource Ink}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                  <Canvas x:Name="TimelineCanvas" Height="220"/>
                </ScrollViewer>
              </Border>
              <WrapPanel x:Name="TimelineLegend" Margin="0,10,0,0"/>
              <TextBlock Text="Erros e alertas ao longo do tempo" FontSize="18" FontWeight="Bold" Margin="0,28,0,8"/>
              <Border x:Name="ChartHost" Height="260" SizeChanged="ChartHost_SizeChanged">
                <Canvas x:Name="ChartCanvas" ClipToBounds="True"/>
              </Border>
              <WrapPanel x:Name="ChartLegend" Margin="0,8,0,0"/>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem x:Name="TabFindings" Header="Diagnóstico">
          <ScrollViewer Foreground="{DynamicResource Ink}" x:Name="FindingsScroll" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="8,16,8,24">
              <TextBlock Text="Diagnóstico" FontSize="24" FontWeight="Bold"/>
              <TextBlock Foreground="{DynamicResource Mute}" Margin="0,6,0,4" TextWrapping="Wrap"
                         Text="Problemas identificados por padrões conhecidos do Netskope Client. Clique em um item para ver o que significa, como resolver passo a passo (com comandos para o sistema do log), a documentação oficial e exemplos do log."/>
              <TextBlock Foreground="{DynamicResource Mute}" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap"
                         Text="Resoluções baseadas em docs.netskope.com e community.netskope.com. Os links abrem no seu navegador padrão apenas quando você clicar neles."/>
              <WrapPanel x:Name="FilterPanel"/>
              <StackPanel x:Name="FindingsPanel" Margin="0,8,0,0"/>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem x:Name="TabDevice" Header="Dispositivo">
          <ScrollViewer Foreground="{DynamicResource Ink}" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="DevicePanel" Margin="8,16,8,24"/>
          </ScrollViewer>
        </TabItem>

        <TabItem x:Name="TabNetwork" Header="Rede">
          <ScrollViewer Foreground="{DynamicResource Ink}" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="NetworkPanel" Margin="8,16,8,24"/>
          </ScrollViewer>
        </TabItem>

        <TabItem x:Name="TabApps" Header="Aplicações">
          <ScrollViewer Foreground="{DynamicResource Ink}" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="AppsPanel" Margin="8,16,8,24"/>
          </ScrollViewer>
        </TabItem>

        <TabItem x:Name="TabConfig" Header="Configuração">
          <ScrollViewer Foreground="{DynamicResource Ink}" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ConfigPanel" Margin="8,16,8,24"/>
          </ScrollViewer>
        </TabItem>

        <TabItem x:Name="TabUnclassified" Header="Não classificados">
          <DockPanel Margin="8,16,8,16">
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Text="Erros não classificados" FontSize="24" FontWeight="Bold"/>
              <TextBlock Foreground="{DynamicResource Mute}" Margin="0,6,0,12" TextWrapping="Wrap"
                         Text="Mensagens de erro/alerta que não batem com nenhum padrão conhecido, agrupadas (números, IPs e IDs foram normalizados). Use “Pesquisar” para buscar a mensagem na documentação e na comunidade Netskope."/>
            </StackPanel>
            <DataGrid x:Name="GridUnclassified">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Mensagem" Binding="{Binding Message}" Width="*">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="4"/></Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Nível" Binding="{Binding LevelText}" Width="70"/>
                <DataGridTextColumn Header="Qtde" Binding="{Binding Count}" Width="60"/>
                <DataGridTextColumn Header="Arquivos" Binding="{Binding Files}" Width="200">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="4"/></Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Última" Binding="{Binding Last}" Width="110"/>
                <DataGridTemplateColumn Header="" Width="110">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Button Content="Pesquisar" Style="{StaticResource Small}" Margin="4" Click="SearchUnclassified_Click"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>

        <TabItem x:Name="TabFiles" Header="Arquivos">
          <DockPanel Margin="8,16,8,16">
            <TextBlock DockPanel.Dock="Top" Text="Arquivos analisados" FontSize="24" FontWeight="Bold" Margin="0,0,0,12"/>
            <TextBlock DockPanel.Dock="Bottom" x:Name="TxtSkipped" Foreground="{DynamicResource Mute}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
            <DataGrid x:Name="GridFiles">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Arquivo" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Tamanho" Binding="{Binding Size}" Width="90"/>
                <DataGridTextColumn Header="Linhas" Binding="{Binding Lines}" Width="80"/>
                <DataGridTextColumn Header="Erros" Binding="{Binding Errors}" Width="70"/>
                <DataGridTextColumn Header="Alertas" Binding="{Binding Warnings}" Width="70"/>
                <DataGridTextColumn Header="Período" Binding="{Binding Period}" Width="260"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>

        <TabItem x:Name="TabExplorer" Header="Explorador">
          <DockPanel Margin="8,16,8,16">
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Text="Explorador de logs" FontSize="24" FontWeight="Bold"/>
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2*"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="1*"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Grid>
                  <TextBox x:Name="XSearch" Padding="8,6" FontSize="15" VerticalContentAlignment="Center" TextChanged="XSearch_TextChanged"/>
                  <TextBlock Text="Buscar texto (ex.: timeout, goskope, Tunnel)" Foreground="{DynamicResource Mute}" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                             x:Name="XSearchHint"/>
                </Grid>
                <ComboBox x:Name="XLevel" Grid.Column="2" Padding="8,6" FontSize="15" SelectionChanged="XFilter_Changed">
                  <ComboBoxItem Content="Erros e alertas" IsSelected="True"/>
                  <ComboBoxItem Content="Só erros/críticos"/>
                  <ComboBoxItem Content="Todos os níveis"/>
                </ComboBox>
                <ComboBox x:Name="XFile" Grid.Column="4" Padding="8,6" FontSize="15" SelectionChanged="XFilter_Changed"/>
              </Grid>
              <TextBlock x:Name="XInfo" Foreground="{DynamicResource Mute}" Margin="0,8,0,6"/>
            </StackPanel>
            <ListBox x:Name="XList" FontFamily="Consolas" FontSize="12.5" BorderBrush="{DynamicResource Line}" Background="{DynamicResource Soft}"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Auto">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}"/>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </TabItem>
      </TabControl>

      <!-- notificação -->
      <Border x:Name="Toast" Background="{DynamicResource Accent}" CornerRadius="18" Padding="18,8" HorizontalAlignment="Center" VerticalAlignment="Bottom"
              Margin="0,0,0,24" Visibility="Collapsed" IsHitTestVisible="False">
        <TextBlock x:Name="ToastText" Foreground="{DynamicResource OnAccent}" FontWeight="SemiBold"/>
      </Border>
    </Grid>
  </DockPanel>
</Window>
