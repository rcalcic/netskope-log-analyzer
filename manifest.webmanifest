{
  "name": "Netskope Log Analyzer",
  "short_name": "Netskope Logs",
  "description": "Analisa pacotes de logs do Netskope Client e mostra falhas e como resolvê-las. Tudo roda localmente.",
  "lang": "pt-BR",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#ffffff",
  "theme_color": "#0e1116",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/zip": [".zip"], "text/plain": [".log"] } }
  ],
  "launch_handler": { "client_mode": "focus-existing" }
}
